# Copy to .env and fill in (never commit .env).
# For EAS builds: also set these on expo.dev → Environment variables (see EAS_ENV.md).
# Local eas build uploads .env via .easignore.
EXPO_PUBLIC_BACKEND_URL=https://your-traveller-api.example.org

# Optional: enables the "Open event in DHIS2" button after a successful scan.
EXPO_PUBLIC_DHIS_WEB_BASE=https://your-dhis2-server.org
EXPO_PUBLIC_DHIS_ORG_UNIT_UID=your-org-unit-id
