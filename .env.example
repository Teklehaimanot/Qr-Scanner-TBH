# Copy to .env and fill in (never commit .env).
# For EAS builds: also set these on expo.dev → Environment variables (see EAS_ENV.md).
# Local eas build uploads .env via .easignore.
# Include /api if that is how your server is set up (e.g. https://tbh.ephi.gov.et/api)
EXPO_PUBLIC_DHIS_BASE=https://your-dhis2-server.org/api
EXPO_PUBLIC_DHIS_TOKEN=your-api-token
EXPO_PUBLIC_DHIS_PROGRAM_UID=your-program-id
EXPO_PUBLIC_DHIS_PROGRAM_STAGE_UID=your-program-stage-id
EXPO_PUBLIC_DHIS_ORG_UNIT_UID=your-org-unit-id
EXPO_PUBLIC_DHIS_QR_SCAN_STATUS_DE_UID=your-qr-scan-status-data-element-id
